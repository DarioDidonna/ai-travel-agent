# Provider del modello: gemini (default, piano gratuito), ollama (locale) oppure openai
LLM_PROVIDER="gemini"
# Facoltativo: modello da usare (default: gemini-3.5-flash / qwen3:4b / gpt-4o)
# LLM_MODEL="gemini-3.5-flash"
# Facoltativo: modello leggero per i tool interni (default: gemini-flash-lite-latest / qwen3:4b / gpt-4o-mini)
# LLM_LIGHT_MODEL="gemini-flash-lite-latest"

GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"
SERPAPI_API_KEY="YOUR_SERPAPI_API_KEY"

# Sicurezza dell'endpoint
# Se impostata, ogni richiesta deve inviare l'header X-API-Key con questo valore (altrimenti 401).
# Lasciala vuota o commentata per lavorare in locale senza chiave.
# API_ACCESS_KEY="una-chiave-lunga-e-casuale"
# Richieste al minuto consentite per indirizzo IP (default 5; 0 = nessun limite)
# RATE_LIMIT_PER_MINUTE=5
# Origini autorizzate a chiamare l'API dal browser, separate da virgole
# CORS_ORIGINS="http://localhost:8000,http://127.0.0.1:8000"
